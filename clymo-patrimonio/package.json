{
  "name": "clymo-patrimonio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1 --port 3100",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1 --port 3100",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint && node scripts/check-boundary.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:database && npm run build && npm run test:e2e",
    "db:start": "node scripts/local-supabase.mjs start",
    "db:check": "node scripts/check-local-stack.mjs",
    "db:stop": "node scripts/local-supabase.mjs stop",
    "db:reset": "node scripts/local-supabase.mjs reset",
    "db:migrate": "node scripts/local-supabase.mjs migrate",
    "db:configure": "node scripts/runtime-config.mjs",
    "db:seed": "tsx scripts/seed-local.ts",
    "test:database": "vitest run tests/database",
    "db:verify-seed": "node scripts/verify-seed.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.116.0",
    "decimal.js": "10.6.0",
    "lucide-react": "1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "server-only": "^0.0.1",
    "uuid": "^14.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@types/pg": "^8.23.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "pg": "^8.23.0",
    "tsx": "^4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
