# Synthetic staging only. Copy/configure secrets securely; never commit .env.local.
NEXT_TELEMETRY_DISABLED=1
APP_ORIGIN=http://127.0.0.1:3100
SUPABASE_URL=http://127.0.0.1:55321
# Server-only official Supabase keys. npm run db:configure generates local values.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local migration/test tooling only. Not needed by the hosted Next runtime.
DATABASE_URL=
# Optional build-time commit supplied by a trusted deployment runner.
# Otherwise next.config.ts reads the local Git commit and working-tree status.
CLYMO_BUILD_COMMIT=
