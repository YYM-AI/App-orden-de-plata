{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clymo-patrimonio-m2",
  "main": "worker.ts",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
}
